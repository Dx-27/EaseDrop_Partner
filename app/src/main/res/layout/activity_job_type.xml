<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".easedroppartner.activity.Job_Type_Activity">

    <TextView

        android:layout_marginTop="30dp"
        android:text="Choose Your Delivery Types:"
        android:textSize="25sp"
        android:textColor="@color/ed"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="730dp"
        android:layout_marginTop="140dp"
        android:orientation="vertical">


        <androidx.cardview.widget.CardView

            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginTop="10dp"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            app:cardElevation="10dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="20dp">

            <LinearLayout

                android:id="@+id/lin_instantDelivery"
                android:layout_width="match_parent"
                android:layout_height="195dp"
                android:orientation="horizontal">

                <ImageView

                    android:layout_width="147dp"
                    android:layout_height="126dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="20dp"
                    android:src="@drawable/bike" />

                <TextView

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="70dp"
                    android:text="Instant Delivery"
                    android:textAlignment="center"
                    android:textColor="@color/ed"
                    android:textSize="15sp"
                    android:textStyle="bold" />


            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView

            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_margin="30dp"
            app:cardElevation="10dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="20dp">

            <LinearLayout

                android:id="@+id/lin_all_india_delivery"
                android:layout_width="match_parent"
                android:layout_height="195dp"
                android:orientation="horizontal">

                <ImageView

                    android:layout_width="147dp"
                    android:layout_height="126dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="20dp"
                    android:src="@drawable/allindia" />

                <TextView

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="70dp"
                    android:text="All India Delivery "
                    android:textAlignment="center"
                    android:textColor="@color/ed"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView

            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            app:cardElevation="10dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="20dp">

        <LinearLayout

            android:id="@+id/lin_heavy_goods"
            android:layout_width="match_parent"
            android:layout_height="195dp"
            android:orientation="horizontal">

            <ImageView

                android:layout_width="147dp"
                android:layout_height="126dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="20dp"
                android:src="@drawable/truck" />

            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="70dp"
                android:text="Heavy Goods"
                android:textAlignment="center"
                android:textColor="@color/ed"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    </LinearLayout>

</RelativeLayout>