                <!--                                android:layout_height="wrap_content"-->
                <!--                                android:backgroundTint="@color/white"-->
                <!--                                android:text="Okay"-->
                <!--                                android:textColor="#EF5B5B"-->
                <!--                                android:textSize="15sp"-->
                <!--                                tools:ignore="HardcodedText" />-->

            </LinearLayout>

        </androidx.cardview.widget.CardView>

