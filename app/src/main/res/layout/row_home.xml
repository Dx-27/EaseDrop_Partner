<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:orientation="vertical"
        android:layout_marginBottom="20dp">

        <androidx.cardview.widget.CardView

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:layout_marginRight="15dp"
            app:cardBackgroundColor="#F4F5FA"
            app:cardCornerRadius="10dp"
            app:cardElevation="5dp">
            <LinearLayout
                android:id="@+id/main"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_marginTop="10dp">

                <LinearLayout

                    android:layout_width="225dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    tools:ignore="UseCompoundDrawables">

                    <ImageView

                        android:id="@+id/img_pro"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_marginLeft="5dp"
                        android:layout_marginTop="5dp"
                        android:src="@drawable/baseline_person_24" />

                    <TextView

                        android:id="@+id/tv_sender_name"
                        android:layout_width="match_parent"
                        android:layout_height="27dp"
                        android:layout_marginLeft="5dp"
                        android:layout_marginTop="5dp"
                        android:text="Solanki Hetshee Anandbhai"
                        android:textColor="@color/black"
                        android:textSize="10sp" />


                </LinearLayout>


                <!--                payment    -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="horizontal">

                    <ImageView

                        android:id="@+id/img_location"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_marginLeft="5dp"
                        android:layout_marginTop="5dp"
                        android:src="@drawable/baseline_location_on_24" />

                    <TextView

                        android:id="@+id/tv_drop_add"
                        android:layout_width="342dp"
                        android:layout_height="33dp"
                        android:layout_marginLeft="5dp"
                        android:layout_marginTop="5dp"
                        android:text="A/302 garden view apprt near the lack garden katargam surat"
                        android:textColor="@color/black"
                        android:textSize="10sp" />


                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView

                        android:id="@+id/img_location2"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_marginLeft="5dp"
                        android:layout_marginTop="5dp"
                        android:src="@drawable/baseline_assistant_navigation_24" />

                    <TextView

                        android:id="@+id/tv_pickup_add"
                        android:layout_width="347dp"
                        android:layout_height="33dp"
                        android:layout_marginLeft="5dp"
                        android:layout_marginTop="5dp"
                        android:text="A/302 garden view apprt near the lack garden katargam surat"
                        android:textColor="@color/black"
                        android:textSize="10sp" />


                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="horizontal">

                    <ImageView

                        android:id="@+id/img_phone"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_marginLeft="5dp"
                        android:layout_marginTop="5dp"
                        android:src="@drawable/baseline_local_phone_24" />

                    <TextView

                        android:id="@+id/tv_sender_phone"
                        android:layout_width="153dp"
                        android:layout_height="27dp"
                        android:layout_marginLeft="5dp"
                        android:layout_marginTop="5dp"
                        android:gravity="center"
                        android:inputType="number"
                        android:text="0987654321"
                        android:textAlignment="textStart"
                        android:textColor="@color/black"
                        android:textSize="10sp"
                        tools:ignore="RtlCompat,TouchTargetSizeCheck" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tv_total"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="0dp"
                            android:gravity="center"
                            android:text="Total"
                            android:textAlignment="center"
                            android:textColor="#A6000000"
                            android:textSize="12sp" />


                        <LinearLayout
                            android:layout_width="108dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="45dp"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/img_currency"
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_marginStart="0dp"
                                android:layout_marginTop="3dp"
                                android:src="@drawable/baseline_currency_rupee_24" />

                            <TextView

                                android:id="@+id/tv_total_amt"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="10000"
                                android:textAlignment="textStart"
                                android:textColor="@color/black"
                                android:textSize="15dp"
                                tools:ignore="RtlCompat,TextSizeCheck" />
                        </LinearLayout>


                    </LinearLayout>


                </LinearLayout>

                <LinearLayout
                    android:layout_width="193dp"
                    android:layout_height="wrap_content"

                    android:orientation="horizontal">

                    <ImageView

                        android:id="@+id/img_pay"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_marginLeft="5dp"
                        android:src="@drawable/baseline_payment_24" />


                    <TextView

                        android:id="@+id/tv_payment_type"
                        android:layout_width="155dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:gravity="center"
                        android:text="Cash On Delivery"
                        android:textAlignment="textStart"
                        android:textColor="@color/black"
                        android:textSize="15dp"
                        tools:ignore="RtlCompat,TextSizeCheck" />


                </LinearLayout>

                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="253dp"
                    android:layout_marginTop="230dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout


                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:orientation="horizontal">

                        <TextView

                            android:id="@+id/tv_resiver_phone"
                            android:layout_width="153dp"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="5dp"
                            android:gravity="center"
                            android:inputType="number"
                            android:text="0987654321"
                            android:textAlignment="textStart"
                            android:textColor="@color/black"
                            android:textSize="10sp"
                            tools:ignore="RtlCompat,TouchTargetSizeCheck" />

                    </LinearLayout>

                    <LinearLayout

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView

                            android:id="@+id/tv_desc"
                            android:layout_width="317dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center"
                            android:text="qwsadfghjkohkjhgfdsaefrthythgfbdsdvvdsvdvdsvdvdvdfvdf"
                            android:textAlignment="textStart"
                            android:textColor="@color/black"
                            android:textSize="15dp"
                            tools:ignore="RtlCompat,TextSizeCheck" />

                    </LinearLayout>

                    <TextView

                        android:id="@+id/tv_resiver_name"
                        android:layout_width="match_parent"
                        android:layout_height="29dp"
                        android:text="02:00" />

                    <TextView

                        android:id="@+id/tv_package_waight"
                        android:layout_width="match_parent"
                        android:layout_height="29dp"
                        android:text="50kg" />

                    <TextView

                        android:id="@+id/tv_is_fragile"
                        android:layout_width="match_parent"
                        android:layout_height="29dp"
                        android:text="50kg" />

                    <TextView

                        android:id="@+id/tv_date"
                        android:layout_width="match_parent"
                        android:layout_height="29dp"
                        android:text="10/30/20" />

                    <TextView

                        android:id="@+id/tv_time"
                        android:layout_width="match_parent"
                        android:layout_height="29dp"
                        android:text="02:00" />

                    <TextView

                        android:id="@+id/sender_lat_lng"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone"/>
                    <TextView

                        android:id="@+id/receiver_lat_lng"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone"/>

                </LinearLayout>

                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="20dp"
                    android:orientation="horizontal">


                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/accept"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:backgroundTint="#4CAF50"
                        android:layout_marginStart="35dp"
                        android:text="Accept"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        app:cornerRadius="10dp"
                        app:strokeColor="#4CAF50" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cancel"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="60dp"
                        android:text="Cancel"
                        android:textColor="@color/ed"
                        app:cornerRadius="10dp"
                        app:strokeColor="#FA1D1D"
                        app:strokeWidth="2dp" />

                </LinearLayout>
            </LinearLayout>




        </androidx.cardview.widget.CardView>
    </LinearLayout>

</RelativeLayout>