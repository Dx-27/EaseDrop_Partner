<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_map_marker_info_window"
    android:elevation="6dp"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/map_info_accent"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_map_info_dot" />

        <TextView
            android:id="@+id/map_info_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Pickup"
            android:textColor="#14213D"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/map_info_address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="2dp"
        android:maxLines="4"
        android:text="Address"
        android:textColor="#586579"
        android:textSize="12sp" />
</LinearLayout>
