<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".easedroppartner.fragment.ProfileFragment">

    <androidx.cardview.widget.CardView

        android:id="@+id/card_pro"
        android:layout_width="match_parent"
        android:layout_height="187dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="#EC6C6C"
        app:cardCornerRadius="20dp">

        <!--    full screen layouxt -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!--        profile linear layout-->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_acc"
                    android:layout_width="175dp"
                    android:layout_height="62dp"
                    android:gravity="center"
                    android:text="Account"
                    android:textColor="@color/white"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="83dp"
                    android:orientation="horizontal">

                    <de.hdodenhof.circleimageview.CircleImageView

                        android:id="@+id/img_dboy"
                        android:layout_width="70dp"
                        android:layout_marginLeft="10dp"
                        android:layout_marginTop="10dp"
                        android:src="@drawable/baseline_account_circle_24"
                        android:layout_height="70dp"/>

                    <LinearLayout
                        android:layout_width="263dp"
                        android:layout_height="61dp"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical">

                        <TextView

                            android:id="@+id/tv_dname"
                            android:layout_width="210dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="Solanki Hetshee"
                            android:textColor="@color/white"/>

                        <TextView

                            android:id="@+id/tv_demail"
                            android:layout_width="149dp"
                            android:layout_height="wrap_content"
                            android:text="solankihetshee@gmail.com"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            tools:ignore="TouchTargetSizeCheck" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="391dp"
        android:layout_height="490dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="210dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout

                android:id="@+id/lin_contactUs"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="15dp"
                    android:src="@drawable/baseline_email_24" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:layout_marginLeft="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/contact_us"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="Contact Us"
                        android:textColor="@color/black"
                        android:textSize="20dp" />

                    <TextView
                        android:id="@+id/tv_contact_us"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Connect us for any Query and issue" />


                </LinearLayout>


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="15dp"
                android:layout_marginTop="7dp"
                android:layout_marginEnd="15dp"
                android:background="#9EA1A1A1" />

            <LinearLayout

                android:id="@+id/lin_terms_and_condition"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="15dp"
                    android:src="@drawable/baseline_article_24" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:layout_marginLeft="10dp"
                    android:orientation="vertical">

                    <TextView

                        android:id="@+id/terms_condition"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="Terms and conditions"
                        android:textColor="@color/black"
                        android:textSize="20dp" />

                    <TextView

                        android:id="@+id/tv_terms_condition"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Know our terms and condition" />


                </LinearLayout>


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="15dp"
                android:layout_marginTop="7dp"
                android:layout_marginEnd="15dp"
                android:background="#9EA1A1A1" />

            <LinearLayout

                android:id="@+id/lin_Language"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="15dp"
                    android:src="@drawable/baseline_language_24" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:layout_marginLeft="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/language"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="Language"
                        android:textColor="@color/black"
                        android:textSize="20dp"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/tv_language"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Select Language" />


                </LinearLayout>


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="15dp"
                android:layout_marginTop="7dp"
                android:layout_marginEnd="15dp"
                android:background="#9EA1A1A1" />

            <LinearLayout

                android:id="@+id/lin_logout"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:orientation="horizontal"
                tools:ignore="UselessLeaf">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="15dp"
                    android:src="@drawable/baseline_logout_24" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:layout_marginLeft="10dp"
                    android:orientation="vertical">

                    <TextView

                        android:id="@+id/logout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="Logout"
                        android:textColor="@color/black"
                        android:textSize="20dp" />

                    <TextView

                        android:id="@+id/tv_logout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sign out from current account" />


                </LinearLayout>


            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>


</RelativeLayout>